<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="migration_price_view_list" model="ir.ui.view">
        <field name="name">migration.price.list</field>
        <field name="model">migration.price</field>
        <field name="arch" type="xml">
            <list>
                <field name="supplier_id"/>
                <field name="module_id"/>
                <field name="supplier_score"/>
                <field name="supplier_capacity"/>
                <field name="price"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="migration_price_view_form" model="ir.ui.view">
        <field name="name">migration.price.form</field>
        <field name="model">migration.price</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="supplier_id"/>
                        <field name="module_id"/>
                        <field name="supplier_score" readonly="1"/>
                        <field name="supplier_capacity" readonly="1"/>
                        <field name="price"/>
                        <field name="currency_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="migration_price_action" model="ir.actions.act_window">
        <field name="name">Price Offers</field>
        <field name="res_model">migration.price</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>