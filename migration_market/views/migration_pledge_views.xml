<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="migration_market_pledge_view_list" model="ir.ui.view">
        <field name="name">migration.market.pledge.list</field>
        <field name="model">migration.market.pledge</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="module_ids" widget="many2many_tags"/>
                <field name="wtp"/>
                <field name="value_of_quality"/>
                <field name="minimum_score"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="migration_market_pledge_view_form" model="ir.ui.view">
        <field name="name">migration.market.pledge.form</field>
        <field name="model">migration.market.pledge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="module_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="wtp"/>
                            <field name="value_of_quality"/>
                            <field name="minimum_score"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="migration_market_pledge_action" model="ir.actions.act_window">
        <field name="name">Pledges</field>
        <field name="res_model">migration.market.pledge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>