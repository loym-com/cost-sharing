<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_app_usage_month_list" model="ir.ui.view">
        <field name="name">app.usage.month.list</field>
        <field name="model">app.usage.month</field>
        <field name="arch" type="xml">
            <list string="Monthly App Usage">
                <field name="year"/>
                <field name="month"/>
                <field name="module_version_id"/>
                <!-- <field name="contract_id"/> -->
                <field name="average_users"/>
                <field name="month_fraction"/>
                <field name="base_price"/>
                <field name="real_price"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_app_usage_month" model="ir.actions.act_window">
        <field name="name">Monthly Aggregates</field>
        <field name="res_model">app.usage.month</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_app_usage_month_list"/>
    </record>
</odoo>
