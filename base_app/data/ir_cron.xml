<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ====================== Daily App Usage ====================== -->
    <record id="ir_cron_app_usage_daily" model="ir.cron">
        <field name="name">Daily App Usage Log</field>
        <field name="model_id" ref="model_app_usage_line"/>
        <field name="code">model.cron_log_daily_usage()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- ====================== Monthly Aggregation ====================== -->
    <record id="ir_cron_app_usage_monthly" model="ir.cron">
        <field name="name">Monthly App Usage Aggregation</field>
        <field name="model_id" ref="model_app_usage_month"/>
        <field name="code">model.cron_aggregate_monthly_usage()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
